@startuml dc-a2-sua-tu-vung
!include _style-dc.iuml

package "Frontend (React)" {
  class AdminLayout {
    +handleSelectMenuItem(path : string) : void
  }
  class ManageVocabularyPage {
    -keyword : string
    -vocabularyStats : VocabularyStat[]
    -selected : VocabularyStat
    +handleChangeKeyword(keyword : string) : void
    +handleSelectVocabulary(vocabulary : VocabularyStat) : void
    +handleSaved(vocabulary : Vocabulary) : void
  }
  class EditVocabularyDrawer {
    -vocabulary : VocabularyStat
    -topics : Topic[]
    +loadTopics() : void
    +handleChooseFile(kind : string, file : File) : void
    +handleSave() : void
    +handleCancel() : void
  }
}

package "Backend (Spring Boot)" {
  class VocabularyAdminController {
    -topicDAO : TopicDAO
    -vocabularyDAO : VocabularyDAO
    -vocabularyStatDAO : VocabularyStatDAO
    -fileStorage : FileStorageService
    +getTopics() : List<Topic>
    +searchVocabulary(keyword : String, topicId : Long) : List<VocabularyStat>
    +uploadMedia(kind : String, content : byte[], contentType : String) : String
    +updateVocabulary(id : Long, vocabulary : Vocabulary) : Vocabulary
  }
  class FileStorageService {
    -storageDir : String
    +storeAudio(content : byte[], contentType : String) : String
    +storeImage(content : byte[], contentType : String) : String
  }
  abstract class DAO {
    #jdbcTemplate : JdbcTemplate
    +DAO(jdbcTemplate : JdbcTemplate)
  }
  class TopicDAO {
    +getTopics() : List<Topic>
  }
  class VocabularyStatDAO {
    +searchVocabulary(keyword : String, topicId : Long) : List<VocabularyStat>
  }
  class VocabularyDAO {
    +checkWordExists(word : String, topicId : Long, excludeId : Long) : boolean
    +updateVocabulary(v : Vocabulary) : boolean
  }
  class Topic {
    -id : Long
    -name : String
    -description : String
    -image : String
    -updatedDate : LocalDate
  }
  class Vocabulary {
    -id : Long
    -word : String
    -phonetic : String
    -meaning : String
    -example : String
    -audio : String
    -image : String
    -level : CefrLevel
    -status : ContentStatus
    -updatedDate : LocalDate
    -topic : Topic
    -creator : User
  }
  class VocabularyStat {
    -learnerCount : int
  }
  class User <<ngoai>>
}

AdminLayout -right- ManageVocabularyPage
ManageVocabularyPage *-- EditVocabularyDrawer

ManageVocabularyPage -- VocabularyAdminController
EditVocabularyDrawer -- VocabularyAdminController

VocabularyAdminController -- TopicDAO
VocabularyAdminController -- VocabularyStatDAO
VocabularyAdminController -- VocabularyDAO
VocabularyAdminController -- FileStorageService
DAO <|-- TopicDAO
DAO <|-- VocabularyStatDAO
DAO <|-- VocabularyDAO
TopicDAO -- Topic
VocabularyStatDAO -- VocabularyStat
VocabularyDAO -- Vocabulary
Vocabulary <|-- VocabularyStat
Vocabulary "*" o-- "0..1" Topic
Vocabulary "*" o-- "1" User
@enduml
