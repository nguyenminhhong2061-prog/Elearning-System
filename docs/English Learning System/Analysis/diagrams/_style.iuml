' Kiểu dùng chung cho các biểu đồ lớp thực thể.
' Lớp thuộc module khác gắn stereotype <<ngoai>>: tô xám, ẩn thuộc tính.
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor black
  ArrowColor black
}
skinparam classBackgroundColor<<ngoai>> #E6E6E6
skinparam classFontColor<<ngoai>> #555555
hide circle
hide methods
hide empty members
hide <<ngoai>> stereotype
hide <<ngoai>> members
