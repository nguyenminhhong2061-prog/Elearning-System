@startuml cd-e-lap-ke-hoach
!include _style.iuml
show methods
hide empty methods

class LearnerHomeView {
  -subPlan
}
class PlanView {
  -outCurrentLevel
  -outSkillChart
  -outsubListTodo
  -subSuggestedGoal
  -inTargetLevel
  -inGoal
  -inStartDate
  -inEndDate
  -subSuggest
}
class SuggestedRoadmapView {
  -outPeriod
  -inoutListWeek
  -subApply
}
class PlanDetailView {
  -outGoal
  -outLevel
  -outPeriod
  -outStatus
  -outCurrentWeek
  -outReminder
  -subShowSchedule
  -outListWeek
  -subAdjustPlan
}

class Learner {
  -currentLevel
}
class StudyPlan {
  -goal
  -targetLevel
  -startDate
  -endDate
  -status
  +getActivePlan()
  +addPlan()
}
class StudyWeek {
  -weekNo
  -description
  -targetWords
  -targetExercises
  -status
}
class Reminder {
  -type
  -remindTime
  -content
  -isSent
  +addReminders()
}
class TestAttempt {
  -listeningScore
  -speakingScore
  -readingScore
  -writingScore
  -suggestedLevel
  -suggestedRoadmap
  +getLatestResult()
}
class ProgressStat {
  -periodName
  -wordsLearned
  -exercisesCompleted
  -avgTestScore
  -studyMinutes
  +getProgressStats()
}
class AIService {
  +suggestRoadmap()
}

LearnerHomeView -right- PlanView
PlanView -right- SuggestedRoadmapView
SuggestedRoadmapView -right- PlanDetailView
PlanView -- PlanDetailView

PlanView -- Learner
PlanView -- StudyPlan
PlanView -- TestAttempt
PlanView -- AIService
SuggestedRoadmapView -- StudyPlan
SuggestedRoadmapView -- Reminder
PlanDetailView -- ProgressStat

Learner "1" -- "*" StudyPlan
StudyPlan "1" *-- "*" StudyWeek
TestAttempt "0..1" -- "*" StudyPlan
Learner "1" -- "*" Reminder
StudyWeek "0..1" -- "0..1" Reminder
Learner "1" -- "*" TestAttempt
@enduml
