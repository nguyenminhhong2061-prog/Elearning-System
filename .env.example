# Copy to .env and fill in real values. .env is ignored by git; never commit credentials.
#
# Local development needs NONE of these: docker-compose.yml and application.properties
# both fall back to the same defaults (database datn, user datn, password datn on localhost:5433).
# Set them only when you point the app at another database, e.g. Neon.

# --- Backend datasource (read by datn/src/main/resources/application.properties) ---
# Neon example (use the DIRECT connection string, not the "-pooler" one, so Flyway can run migrations):
# DB_URL=jdbc:postgresql://ep-xxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=your_neon_role
# DB_PASSWORD=your_neon_password

# --- Authentication ---
# JWT_SECRET signs the access tokens (at least 32 bytes, e.g. `openssl rand -base64 48`). If empty, a random
# secret is generated on every start, so users must log in again after each restart. Always set it on Neon/demo.
# JWT_SECRET=
# Bootstrap admin account, created at startup only when BOTH are set (password 8-72 characters).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Module B4: Groq chatbot ---
# Optional backup credential. Keys in the same organization share rate limits.
# GROQ_API_KEY=
# GROQ_BACKUP_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Module B listening audio: read-only R2 S3 API access for the backend proxy ---
# Create an R2 API token scoped to only the learning-audio bucket with Object Read only permission.
# R2_ENABLED=true
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=learning-audio
# R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional fallback if you prefer direct public R2 URLs instead of the backend proxy:
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- Module B3: self-hosted OpenPronounce pronunciation service ---
# Start it with: docker compose -f compose.openpronounce.yml up --build -d
# Keep the analysis service local/private; the Spring backend forwards recordings to it.
OPENPRONOUNCE_BASE_URL=http://localhost:8001
OPENPRONOUNCE_PORT=8001
# Optional timeouts for first model load/inference (Spring duration format).
OPENPRONOUNCE_CONNECT_TIMEOUT=5s
OPENPRONOUNCE_READ_TIMEOUT=600s
# Optional: change only when deliberately pinning/testing another upstream revision.
# OPENPRONOUNCE_REF=main

# --- docker-compose.yml overrides (optional) ---
# POSTGRES_DB=datn
# POSTGRES_USER=datn
# POSTGRES_PASSWORD=datn
# POSTGRES_PORT=5433
