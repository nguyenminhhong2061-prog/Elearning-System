# Copy to .env and fill in real values. .env is ignored by git; never commit credentials.
#
# Local development needs NONE of these: docker-compose.yml and application.properties
# both fall back to the same defaults (database datn, user datn, password datn on localhost:5433).
# Set them only when you point the app at another database, e.g. Neon.

# --- Backend datasource (read by datn/src/main/resources/application.properties) ---
# Neon example (use the DIRECT connection string, not the "-pooler" one, so Flyway can run migrations):
# DB_URL=jdbc:postgresql://ep-xxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=your_neon_role
# DB_PASSWORD=your_neon_password

# --- Authentication ---
# JWT_SECRET signs the access tokens (at least 32 bytes, e.g. `openssl rand -base64 48`). If empty, a random
# secret is generated on every start, so users must log in again after each restart. Always set it on Neon/demo.
# JWT_SECRET=
# Bootstrap admin account, created at startup only when BOTH are set (password 8-72 characters).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- docker-compose.yml overrides (optional) ---
# POSTGRES_DB=datn
# POSTGRES_USER=datn
# POSTGRES_PASSWORD=datn
# POSTGRES_PORT=5433
