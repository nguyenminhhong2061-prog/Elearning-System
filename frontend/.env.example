# Copy to .env.local (ignored by git) only when you need to change a default.

# Base URL the browser uses for API calls. Leave empty in development: requests go to the Vite dev server,
# which proxies /api to the backend (see vite.config.js), so no CORS setup is needed.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api (read by vite.config.js, not exposed to the browser).
DEV_API_PROXY_TARGET=http://localhost:8080
